# ── Basics ────────────────────────────────────────────────────────────────────

set $mod Mod4
set $terminal kitty
set $browser firefox
set $menu exec --no-startup-id $HOME/.config/rofi/launchers/type-1/launcher.sh
set $power exec --no-startup-id $HOME/.config/rofi/powermenu/type-2/powermenu.sh

# Colors
font pango:CaskaydiaMono Nerd Font 11
set $bg   #1e1e2e
set $bg2  #181825
set $fg   #cdd6f4
set $acc  #89b4fa
set $red  #f38ba8
set $grn  #a6e3a1
set $ylw  #f9e2af

# ── Style: gaps, borders, smart stuff ─────────────────────────────────────────

gaps inner 12
gaps outer 8
smart_gaps on
smart_borders on

default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# Window colors
client.focused          $acc   $acc   $bg2   $fg
client.focused_inactive $bg    $bg    $bg2   $fg
client.unfocused        $bg    $bg    $bg2   #7f849c
client.urgent           $red   $red   $bg2   $fg
client.placeholder      $bg    $bg    $bg2   $fg

# Title formatting (compact)
for_window [class=".*"] title_format "%title"

# ── Autostart ─────────────────────────────────────────────────────────────────

exec --no-startup-id feh --bg-scale "$HOME/pictures/wallpapers/city.jpeg"

# Use a real picom config (see picom.conf below)
exec --no-startup-id picom --experimental-backends --config "$HOME/.config/picom/picom.conf" &

# i3bar
bar {
    status_command i3status
    tray_output primary
    position top
    font pango:CaskaydiaMono Nerd Font 11
    colors {
        background $bg
        statusline $fg
        separator  #6c7086
        focused_workspace  $acc $acc $bg2
        active_workspace   $bg  $bg  $fg
        inactive_workspace $bg2 $bg2 #a6adc8
        urgent_workspace   $red $red $bg2
    }
}

exec_always --no-startup-id setxkbmap us dvorak -option ctrl:nocaps
exec_always --no-startup-id xset r rate 200 50

# ── Keybindings ───────────────────────────────────────────────────────────────

bindsym $mod+Return exec $terminal
bindsym $mod+b exec $browser
bindsym $mod+Shift+Return $menu
bindsym $mod+Escape $power
bindsym $mod+c kill

bindsym $mod+m fullscreen toggle
bindsym $mod+w floating toggle
bindsym $mod+v move position 20 px 20 px

# Resize (vim-ish)
bindsym $mod+Shift+h resize shrink width 50 px or 5 ppt
bindsym $mod+Shift+l resize grow width 50 px or 5 ppt
bindsym $mod+Shift+k resize shrink height 50 px or 5 ppt
bindsym $mod+Shift+j resize grow height 50 px or 5 ppt

# Focus (vim-ish)
bindsym $mod+Control+h focus left
bindsym $mod+Control+l focus right
bindsym $mod+Control+k focus up
bindsym $mod+Control+j focus down

# Toggle split orientation
bindsym $mod+j split toggle

# Screenshots
bindsym $mod+s exec bash ~/.local/bin/screenshot.sh

# Scratchpad (super handy)
bindsym $mod+minus move scratchpad
bindsym $mod+Shift+minus scratchpad show

# Quick gaps adjust
bindsym $mod+g exec i3-msg 'gaps inner current set 12; gaps outer current set 8'
bindsym $mod+Shift+g exec i3-msg 'gaps inner current plus 4; gaps outer current plus 2'
bindsym $mod+Control+g exec i3-msg 'gaps inner current minus 4; gaps outer current minus 2'

# ── Workspaces (1–9 with icons) ──────────────────────────────────────────────
# Requires Nerd Font for the glyphs to render in bar
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"

bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9

bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9

# Scroll through workspaces + back-and-forth
bindsym $mod+h workspace prev
bindsym $mod+l workspace next
workspace_auto_back_and_forth yes
bindsym $mod+Tab workspace back_and_forth

# ── Floating rules / niceties ────────────────────────────────────────────────

for_window [window_role="pop-up"] floating enable
for_window [window_role="bubble"] floating enable
for_window [class="Pavucontrol"] floating enable, move position center
for_window [class="mpv"] floating enable, sticky enable
for_window [class="Nm-connection-editor"] floating enable
for_window [class="^([Tt]hunar|[Nn]autilus)$"] opacity 0.98

# Mouse modifier to move/resize floating windows
floating_modifier $mod
